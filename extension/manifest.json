{
  "manifest_version": 3,
  "name": "BlogAutoWrite Helper",
  "version": "1.0.7",
  "description": "AI로 생성한 포스팅 본문을 블로그 에디터에 자동으로 주입해 줍니다.",
  "permissions": [
    "activeTab",
    "scripting",
    "storage"
  ],
  "host_permissions": [
    "https://blog.naver.com/*",
    "https://editor.blog.naver.com/*",
    "http://localhost:3000/*",
    "http://127.0.0.1:3000/*",
    "https://*.vercel.app/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icon.png",
      "48": "icon.png",
      "128": "icon.png"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "https://blog.naver.com/*",
        "https://editor.blog.naver.com/*",
        "http://localhost:3000/*",
        "http://127.0.0.1:3000/*",
        "https://*.vercel.app/*"
      ],
      "js": ["content.js"],
      "run_at": "document_idle",
      "all_frames": true
    }
  ]
}
