datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id                String             @id @default(uuid())
  email             String             @unique
  naverBlogId       String?
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  apiKeys           ApiKey[]
  blogPosts         BlogPost[]
  referencePosts    ReferencePost[]
  defaultReferences DefaultReference[]
}

model ApiKey {
  id           String   @id @default(uuid())
  userId       String
  provider     String   // "OPENAI", "GEMINI", "CLAUDE" 등
  encryptedKey String   // Secure Mode로 암호화된 API Key
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, provider])
}

model BlogPost {
  id             String          @id @default(uuid())
  userId         String
  title          String?
  content        String?
  document       Json?
  place          String?
  status         String          @default("PENDING") // PENDING, PROCESSING, COMPLETED, FAILED
  errorMessage   String?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  user           User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  images         Image[]
  referencePosts ReferencePost[]
}

model ReferencePost {
  id         String    @id @default(uuid())
  userId     String
  blogPostId String?
  title      String?
  content    String    @db.Text
  createdAt  DateTime  @default(now())
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  blogPost   BlogPost? @relation(fields: [blogPostId], references: [id], onDelete: SetNull)
}

model Image {
  id         String   @id @default(uuid())
  blogPostId String
  url        String
  role       String   // "REFERENCE" or "INCLUDED"
  createdAt  DateTime @default(now())
  blogPost   BlogPost @relation(fields: [blogPostId], references: [id], onDelete: Cascade)
}

model DefaultReference {
  id        String   @id @default(uuid())
  userId    String
  content   String   @db.Text
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}
